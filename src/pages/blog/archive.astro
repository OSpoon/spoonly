---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter(post => !post.data.isDraft || import.meta.env.DEV)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce<Map<number, typeof posts>>((groups, post) => {
	const year = post.data.pubDate.getFullYear();
	const group = groups.get(year) ?? [];
	group.push(post);
	groups.set(year, group);
	return groups;
}, new Map());

const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<Layout
	title="Blog Archive"
	description="OSpoon 博客文章按年份归档。"
>
	<header class="page-header">
		<div>
			<h1>Archive</h1>
			<p>{posts.length} posts organized by publication year.</p>
		</div>
		<a class="back-link" href="/blog">Blog</a>
	</header>

	<div class="archive-list">
		{years.map(year => (
			<section class="year-group">
				<h2>{year}</h2>
				<div class="year-posts">
					{postsByYear.get(year)?.map(post => (
						<article class="archive-item">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('zh-CN', {
									month: '2-digit',
									day: '2-digit',
								})}
							</time>
							<div>
								<h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>
		))}
	</div>
</Layout>

<style>
	.page-header {
		padding: 2rem 0;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 3rem;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.page-header h1 {
		margin-top: 0;
		font-size: 1.85rem;
	}

	.page-header p {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 0;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		padding: 0 0.85rem;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		color: var(--text-muted);
		font-size: 0.8rem;
		font-family: 'JetBrains Mono', monospace;
		white-space: nowrap;
	}

	.archive-list {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.year-group {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 2.5rem;
	}

	.year-group h2 {
		margin: 0;
		font-size: 1rem;
		font-family: 'JetBrains Mono', monospace;
		color: var(--text-muted);
	}

	.year-posts {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.archive-item {
		display: grid;
		grid-template-columns: 72px 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.archive-item time {
		color: var(--text-muted);
		font-size: 0.8rem;
		font-family: 'JetBrains Mono', monospace;
		padding-top: 0.35rem;
	}

	.archive-item h3 {
		margin: 0 0 0.35rem 0;
		font-size: 1.2rem;
	}

	.archive-item p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	@media (max-width: 640px) {
		.page-header {
			flex-direction: column;
			gap: 1rem;
		}

		.year-group {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.archive-item {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
